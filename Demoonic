local function createTabPage(name, buttonConfigs)
	local page = Instance.new("ScrollingFrame", ContentArea)
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.ScrollBarThickness = 2
	page.ScrollBarImageColor3 = Theme.SubText
	page.Visible = false
	page.Position = UDim2.new(0, 20, 0, 0)

	local layout = Instance.new("UIListLayout", page)
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder

	createSectionLabel(name:upper(), page)

	for _, config in ipairs(buttonConfigs) do
		if config.type == "toggle" then
			createToggleButton(config.name, page, config.order or 0)
		elseif config.type == "action" then
			createActionButton(config.name, page, config.order or 0, config.callback)
		elseif config.type == "player_select" then
			createPlayerSelectButton(config.name, page, config.order or 0, config.actionType)
		end
	end

	return page
end

