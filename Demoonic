	if activeTab == index then return end
	activeTab = index

	for i, btn in ipairs(tabButtons) do
		setTabActive(btn, i == index)
	end

	for i, page in ipairs(tabPages) do
		if i == index then
			page.Visible = true
			page.Position = UDim2.new(0, 20, 0, 0)
			TweenService:Create(page, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
		else
			page.Visible = false
