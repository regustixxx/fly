	print("Teleported " .. targetPlayer.Name .. " to coordinates")
end

-- ===== SET PLAYER HP TO 0 =====
local function setPlayerHPToZero(targetPlayer)
	if not targetPlayer or targetPlayer == Player then 
		print("Cannot do this to yourself!")
		return 
	end
	
	local char = targetPlayer.Character
	if not char then 
		print("Player has no character")
		return 
	end
	
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	humanoid.Health = 0
	print("Set " .. targetPlayer.Name .. "'s HP to 0")
end

