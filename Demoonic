	btn.Position = UDim2.new(0, 0, 0, 0)
	btn.Text = name .. "  "
	btn.BackgroundColor3 = Theme.Btn
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.TextColor3 = Theme.BtnText
	btn.TextXAlignment = Enum.TextXAlignment.Center
	btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke", btn)
	stroke.Thickness = 1
	stroke.Color = Theme.Stroke
	stroke.Transparency = 0.55

	local indicator = Instance.new("Frame", btn)
	indicator.Size = UDim2.new(0, 34, 0, 18)
	indicator.Position = UDim2.new(1, -42, 0.5, -9)
	indicator.BackgroundColor3 = Color3.fromRGB(60, 60, 64)
	indicator.BackgroundTransparency = 0
	indicator.ZIndex = 2
	Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

	local indicatorCircle = Instance.new("Frame", indicator)
	indicatorCircle.Size = UDim2.new(0, 14, 0, 14)
	indicatorCircle.Position = UDim2.new(0, 2, 0.5, -7)
	indicatorCircle.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
	Instance.new("UICorner", indicatorCircle).CornerRadius = UDim.new(1, 0)

	local state = false

	local function updateIndicator()
		if state then
			TweenService:Create(indicator, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(0, 200, 100)}):Play()
			TweenService:Create(indicatorCircle, TweenInfo.new(0.15), {Position = UDim2.new(0, 18, 0.5, -7)}):Play()
			TweenService:Create(indicatorCircle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		else
			TweenService:Create(indicator, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 60, 64)}):Play()
			TweenService:Create(indicatorCircle, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
			TweenService:Create(indicatorCircle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
		end
	end

	btn.MouseButton1Click:Connect(function()
		state = not state
		updateIndicator()
		
		if name == "Fly" then
			toggleFly(state)
		elseif name == "Noclip" then
			toggleNoclip(state)
		elseif name == "Invisible" then
			toggleInvisible(state)
		end
	end)

	btn.MouseEnter:Connect(function()
		if not state then
			TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.BtnHover}):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if not state then
			TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.Btn}):Play()
		end
	end)

	return frame
end

