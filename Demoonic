-- ===== TELEPORT TOOLS =====
local function teleportTools()
	local char = Player.Character
	if not char then return end
	local rootPart = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
	if not rootPart then return end
	
	local toolCount = 0
	local spawnedItems = Workspace:FindFirstChild("Spawned Items")
	
	if spawnedItems then
		for _, item in ipairs(spawnedItems:GetChildren()) do
			if item:IsA("Tool") then
				local handle = item:FindFirstChild("Handle")
				if handle then
					handle.CFrame = rootPart.CFrame * CFrame.new(0, 3, 0)
					toolCount = toolCount + 1
					task.wait(0.02)
				else
					item:SetPrimaryPartCFrame(rootPart.CFrame * CFrame.new(0, 3, 0))
					toolCount = toolCount + 1
					task.wait(0.02)
				end
			end
		end
	end
	
	for _, item in ipairs(Workspace:GetChildren()) do
		if item:IsA("Tool") then
			local isInSpawned = false
			if spawnedItems then
				for _, spawned in ipairs(spawnedItems:GetChildren()) do
					if spawned == item then
						isInSpawned = true
						break
					end
				end
			end
			
			if not isInSpawned then
				local handle = item:FindFirstChild("Handle")
				if handle then
					handle.CFrame = rootPart.CFrame * CFrame.new(0, 3, 0)
					toolCount = toolCount + 1
					task.wait(0.02)
				else
					item:SetPrimaryPartCFrame(rootPart.CFrame * CFrame.new(0, 3, 0))
					toolCount = toolCount + 1
					task.wait(0.02)
				end
			end
		end
	end
	
	print("Teleported " .. toolCount .. " tools to player")
end

