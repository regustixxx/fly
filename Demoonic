local function createShadow(target, blurSize, transparency)
	blurSize = blurSize or 20
	transparency = transparency or 0.3
	
	local shadow = Instance.new("ImageLabel")
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.BackgroundTransparency = 1
	shadow.Image = "rbxassetid://5011721500"
	shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
	shadow.ImageTransparency = transparency
	shadow.ScaleType = Enum.ScaleType.Slice
	shadow.SliceCenter = Rect.new(10, 10, 10, 10)
	shadow.ZIndex = math.max(target.ZIndex - 1, 0)
	shadow.Parent = target.Parent
	
	local function sync()
		local size = target.AbsoluteSize
		local pos = target.AbsolutePosition
		shadow.Size = UDim2.fromOffset(size.X + blurSize * 2, size.Y + blurSize * 2)
		shadow.Position = UDim2.fromOffset(pos.X - blurSize + size.X / 2, pos.Y - blurSize + size.Y / 2)
		shadow.Visible = target.Visible and size.X > 0 and size.Y > 0
	end
	
	target:GetPropertyChangedSignal("AbsoluteSize"):Connect(sync)
	target:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	sync()
	
	return shadow
end

