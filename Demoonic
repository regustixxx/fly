	dropStroke.Color = Theme.Stroke
	dropStroke.Transparency = 0.35

	local listLayout = Instance.new("UIListLayout", dropList)
	listLayout.Padding = UDim.new(0, 2)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder

	local selectedPlayer = nil
	local isOpen = false

	local function updateDropdown()
		local players = Players:GetPlayers()
		local height = math.min((#players - 1) * 28 + 4, 120)
		dropList.Size = UDim2.new(1, 0, 0, height)
		dropList.Visible = isOpen
		
		for _, child in ipairs(dropList:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		
		local index = 0
		for _, plr in ipairs(players) do
			if plr ~= Player then
				index = index + 1
				local plrBtn = Instance.new("TextButton", dropList)
				plrBtn.Size = UDim2.new(1, -8, 0, 26)
				plrBtn.Position = UDim2.new(0, 4, 0, 0)
				plrBtn.LayoutOrder = index
				plrBtn.BackgroundColor3 = Theme.Btn
				plrBtn.Text = plr.Name
				plrBtn.Font = Enum.Font.Gotham
				plrBtn.TextSize = 11
				plrBtn.TextColor3 = Theme.BtnText
				plrBtn.TextXAlignment = Enum.TextXAlignment.Left
				plrBtn.AutoButtonColor = false
				plrBtn.ZIndex = 11
				Instance.new("UICorner", plrBtn).CornerRadius = UDim.new(0, 6)
				
				plrBtn.MouseButton1Click:Connect(function()
					selectedPlayer = plr
					selectBtn.Text = plr.Name
					selectBtn.TextColor3 = Theme.Text
					isOpen = false
					dropList.Visible = false
				end)
				
				plrBtn.MouseEnter:Connect(function()
					TweenService:Create(plrBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.BtnHover}):Play()
				end)
				plrBtn.MouseLeave:Connect(function()
					TweenService:Create(plrBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Btn}):Play()
				end)
			end
		end
	end

	selectBtn.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		updateDropdown()
	end)

	selectBtn.MouseEnter:Connect(function()
		TweenService:Create(selectBtn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.BtnHover}):Play()
	end)
	selectBtn.MouseLeave:Connect(function()
		TweenService:Create(selectBtn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.Btn}):Play()
	end)

	actionBtn.MouseButton1Click:Connect(function()
		if not selectedPlayer then
			print("Please select a player first!")
			return
		end
		
		if actionType == "steal" then
			stealToolsFromPlayer(selectedPlayer)
		elseif actionType == "kick" then
			kickPlayer(selectedPlayer)
		elseif actionType == "teleport" then
			teleportPlayerToCoords(selectedPlayer)
		elseif actionType == "hpzero" then
			setPlayerHPToZero(selectedPlayer)
		end
		
		TweenService:Create(actionBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.BtnHover}):Play()
		task.wait(0.1)
		TweenService:Create(actionBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Btn}):Play()
	end)

	actionBtn.MouseEnter:Connect(function()
		TweenService:Create(actionBtn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.BtnHover}):Play()
	end)
	actionBtn.MouseLeave:Connect(function()
		TweenService:Create(actionBtn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.Btn}):Play()
	end)

	return frame
end

