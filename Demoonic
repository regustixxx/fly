	rootPart.CFrame = CFrame.new(-132.4492950439453, 3.648467540740967, 97.95744323730469)
	
	task.wait(0.5)
	if not wasNoclip then
		toggleNoclip(false)
	end
	
	print("Teleported to coordinates")
end

-- ===== STEAL TOOLS FROM PLAYER =====
local function stealToolsFromPlayer(targetPlayer)
	if not targetPlayer or targetPlayer == Player then return end
	
	local playerBackpack = targetPlayer:FindFirstChild("Backpack")
	local myBackpack = Player:FindFirstChild("Backpack")
	if not myBackpack then return end
	
	local toolsStolen = 0
	
	if playerBackpack then
		local tools = playerBackpack:GetChildren()
		for _, tool in ipairs(tools) do
			if tool:IsA("Tool") then
				tool.Parent = myBackpack
				toolsStolen = toolsStolen + 1
			end
		end
	end
	
	local char = targetPlayer.Character
	if char then
		local currentTool = char:FindFirstChildOfClass("Tool")
		if currentTool then
			currentTool.Parent = myBackpack
			toolsStolen = toolsStolen + 1
		end
	end
	
	print("Stolen " .. toolsStolen .. " tools from " .. targetPlayer.Name)
end

